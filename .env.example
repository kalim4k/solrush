# Copy to .env and fill in. Never commit .env.

# Neon — take the POOLED connection string from the Neon console
# (the host ends in -pooler). The direct host runs out of connections the
# moment more than a handful of players are online.
#
# sslmode=verify-full, not the sslmode=require Neon hands you. pg treats them
# the same today and warns that it will stop in v9; more to the point, "require"
# means encrypt without checking who answered, and this connection carries every
# password hash in the database.
DATABASE_URL=postgresql://user:password@ep-xxxx-pooler.eu-central-1.aws.neon.tech/neondb?sslmode=verify-full

# Signs the login tokens. Any long random string; changing it logs everyone out.
# Generate one with:  node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=

# 3210 rather than 3000: 3000 is what every other Node project on a laptop is
# already using, and on Windows two processes can bind it at once — the traffic
# then goes to whichever answers first, and neither is obviously broken.
PORT=3210

# Where the site is served from — used for invite links and CORS. Keep the port
# in step with PORT above, or password-reset links point somewhere else.
PUBLIC_ORIGIN=http://localhost:3210

# Optional: password-reset emails. Left empty, the reset endpoint returns the
# link in its response so you can test the flow without a mail provider.
RESEND_API_KEY=
MAIL_FROM=noreply@example.com

# Optional: a TURN relay for voice chat in friend rooms.
#
# Without it, STUN handles most pairs and the call simply fails for the rest —
# typically when both players are on mobile networks. With it, the audio is
# relayed and connects anywhere. coturn on a small VPS is enough.
#
# These are handed to the browser, because TURN is authenticated by the client:
# anyone who plays can read them. Use short-lived credentials in production.
TURN_URL=
TURN_USER=
TURN_PASS=
